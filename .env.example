# Copy to .env.local and fill in. .env* is gitignored — never commit a real key.

# Groq API key. Enables the AI "Your edge" review on every analysis.
# Get one at https://console.groq.com/keys — without it the analyzer still runs,
# it just skips the editorial read.
GROQ_API_KEY=

# Optional second key, tried only when the first is rate-limited or rejected —
# a backup so a busy key does not take every AI feature down with it.
GROQ_API_KEY2=

# Optional. Any Groq text model; see https://console.groq.com/docs/models.
# Default: openai/gpt-oss-120b
GROQ_MODEL=

# Optional. Milliseconds to wait for the model before giving up. Default: 20000
AI_TIMEOUT_MS=

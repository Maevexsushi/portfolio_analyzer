# Copy to .env.local and fill in. .env* is gitignored — never commit a real key.

# Groq API key. Enables the AI "Your edge" review on every analysis.
# Get one at https://console.groq.com/keys — without it the analyzer still runs,
# it just skips the editorial read.
GROQ_API_KEY=

# Optional second key, tried only when the first is rate-limited or rejected —
# a backup so a busy key does not take every AI feature down with it.
GROQ_API_KEY2=

# Optional. Any Groq text model; see https://console.groq.com/docs/models.
# Default: openai/gpt-oss-120b
GROQ_MODEL=

# Optional. Milliseconds to wait for the model before giving up. Default: 20000
AI_TIMEOUT_MS=

# Required. Analysis history (the report you land on after analyzing, the History
# page, and Compare) is stored in a Supabase Postgres table rather than a local file
# — a local file works for `next dev` but silently fails on Vercel, whose serverless
# functions run on a read-only filesystem. Run the migration in
# supabase/migrations/ against your Supabase project before using either var.
#
# Project Settings -> API in your Supabase dashboard.
SUPABASE_PROJECT_URL=

# Project Settings -> API -> service_role secret. This key bypasses row-level
# security, so it must only ever be read server-side (it already is — history.ts is
# never imported by a "use client" file) and never committed or sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Not used by this app (no anon/browser-side Supabase access), but harmless to leave
# set if your dashboard's connection snippet included them alongside the two above.
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=
